# Telegram BotFather token (never commit real values)
TELEGRAM_BOT_TOKEN=

# polling (local) | webhook (prod)
BOT_MODE=polling
BOT_PORT=3003
BOT_WEBHOOK_PATH=/telegram/webhook
# Full public URL Telegram will POST updates to (webhook mode)
BOT_WEBHOOK_URL=
# Optional secret_token for webhook verification
BOT_WEBHOOK_SECRET=

# Mini App link used by "Открыть Mini App" / afisha / tickets buttons
# Prefer a direct HTTPS URL to the Mini App host, e.g. https://mini.example.com
TELEGRAM_MINI_APP_URL=
# Or t.me deep-link pieces when URL is unset:
TELEGRAM_BOT_USERNAME=
TELEGRAM_MINI_APP_SHORT_NAME=app
