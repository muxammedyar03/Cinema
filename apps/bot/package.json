{
	"name": "@cinema/bot",
	"version": "0.0.0",
	"private": true,
	"scripts": {
		"dev": "tsx watch src/index.ts",
		"build": "tsc -p tsconfig.json",
		"start": "node dist/index.js",
		"start:polling": "BOT_MODE=polling tsx src/index.ts",
		"start:webhook": "BOT_MODE=webhook tsx src/index.ts"
	},
	"dependencies": {
		"dotenv": "^16.5.0",
		"grammy": "^1.36.3"
	},
	"devDependencies": {
		"@types/node": "^22.15.32",
		"tsx": "^4.20.3",
		"typescript": "^5.8.3"
	}
}
