{
	"name": "cinema",
	"private": true,
	"packageManager": "pnpm@9.15.0",
	"scripts": {
		"dev": "turbo run dev --parallel",
		"build": "turbo run build",
		"typecheck": "turbo run typecheck",
		"test:unit": "turbo run test:unit --filter=@cinema/api --filter=@cinema/worker --filter=@cinema/bot --filter=@cinema/queue-contracts --filter=@cinema/admin",
		"lint": "biome check .",
		"format": "biome check --write .",
		"check": "biome check ."
	},
	"devDependencies": {
		"@biomejs/biome": "2.2.0",
		"turbo": "^2.5.4",
		"typescript": "^5.8.3"
	}
}
