#!/bin/sh
# Runs before git push. A failing check blocks the push; a passing run does not.
set -eu

root=$(git rev-parse --show-toplevel)
cd "$root"

pushing=0
while read -r _local_ref local_sha _remote_ref _remote_sha; do
	if [ "$local_sha" != "0000000000000000000000000000000000000000" ]; then
		pushing=1
	fi
done

if [ "$pushing" -eq 0 ]; then
	exit 0
fi

echo "pre-push: typecheck, biome, unit tests, prisma"
pnpm check:push
